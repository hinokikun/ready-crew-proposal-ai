{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-crew.local/schemas/v81/proposal-brief.schema.json",
  "title": "ProposalBrief",
  "type": "object",
  "required": ["schema_version", "project_name", "customer_name", "problems"],
  "properties": {
    "schema_version": { "type": "string", "const": "v1" },
    "project_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "industry": { "type": "string", "maxLength": 80 },
    "category": { "type": "string", "enum": ["vision_ocr", "automation", "crm", "knowledge_ai", "conversational_ai", "digital_experience", "generative_ai", "generic"] },
    "business_context": { "type": "string", "maxLength": 4000 },
    "problems": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "maxLength": 300 } },
    "goals": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 300 } },
    "decision_maker": { "type": "string", "maxLength": 120 },
    "budget": { "type": "string", "maxLength": 120 },
    "deadline": { "type": "string", "maxLength": 120 },
    "competitors": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 120 } },
    "constraints": { "type": "array", "maxItems": 12, "items": { "type": "string", "maxLength": 240 } },
    "assumptions": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 240 } }
  },
  "additionalProperties": false
}

